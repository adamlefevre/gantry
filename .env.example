# Local settings for the Makefile and scripts/smoke-task.sh. Copy to .env (never committed).
# The deployed Worker gets its secrets from `npx wrangler secret put`, not from this file.
# See docs/deploy.md.

# Execution sandbox (Modal). The URL `make modal-deploy` prints.
MODAL_SANDBOX_URL=https://<your-modal-workspace>--sandbox-service.modal.run
# Shared by the Worker and the Modal secret "agent-sandbox-secret". Generate with: openssl rand -hex 32
AGENT_SANDBOX_TOKEN=generate_a_long_random_token

# Control plane (Cloudflare Worker)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Callers send it as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
GANTRY_API_TOKEN=generate_another_long_random_token
# The Worker URL `make deploy` prints.
GANTRY_URL=https://gantry-control-plane.<your-subdomain>.workers.dev
